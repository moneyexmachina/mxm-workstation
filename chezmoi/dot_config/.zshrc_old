# Minimal clean ZSH config


# Use starship for prompt
eval "$(starship init zsh)"

# History settings
HISTSIZE=5000
SAVEHIST=5000
HISTFILE=~/.zsh_history

# Editor fallback
export EDITOR=nvim
export TMUX_CONF="$HOME/.config/tmux/tmux.conf"

export YABAI_SOCKET=/tmp/yabai_mxm.socket

# Aliases
alias ll="ls -lah"
alias age-d="age -d -i ~/.age.key"
alias mxm-daily-note="~/mxm-core/bin/new_daily_note.sh"
alias stage-theme="~/mxm-core/bin/stage-theme.sh"
alias tmux="tmux -f $TMUX_CONF"
alias kimg="kitty +kitten icat"

# Enable basic keybindings
bindkey -v # vi-style movement

# Source local overrides if they exist
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# Created by `pipx` on 2025-06-03 14:50:29
export PATH="$PATH:/Users/mxm/.local/bin"
export PATH="$PATH:/Users/mxm/mxm-core/bin"

export PATH="/Library/TeX/texbin:$PATH"

logit() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [mxm] $*" >> /var/log/mxm/actions.log
}

