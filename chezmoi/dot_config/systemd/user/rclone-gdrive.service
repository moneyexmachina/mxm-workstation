[Unit]
Description=Rclone Google Drive mount
Documentation=https://rclone.org/drive/ https://rclone.org/commands/rclone_mount/
After=default.target

[Service]
Type=notify

ExecStart=/usr/bin/rclone mount gdrive: /mnt/gdrive \
    --config=%h/.config/rclone/rclone.conf \
    --cache-dir=%h/.cache/rclone/gdrive-vfs \
    --vfs-cache-mode=full \
    --vfs-cache-max-size=20G \
    --vfs-cache-max-age=168h \
    --dir-cache-time=72h \
    --poll-interval=1m \
    --drive-export-formats=link.html \
    --umask=077

ExecStartPre=/usr/bin/test -d /mnt/gdrive
ExecStartPre=/usr/bin/test -r %h/.config/rclone/rclone.conf
ExecStartPre=/usr/bin/mkdir -p %h/.cache/rclone/gdrive-vfs

Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
