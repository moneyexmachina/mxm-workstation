{
	// ---------------------------------------------------------------------
	// Alex private infrastructure management plane
	//
	// Governing architecture:
	//     ~/.tailscale-management/README.md
	//
	// Tailscale provides private network reachability and service identity.
	//
	// Administrative trust model:
	//
	//   Alex-owned fixed infrastructure:
	//       ordinary OpenSSH
	//
	//   Reconstructible MXM service appliances:
	//       Tailscale SSH
	//
	// Tailscale therefore manages both network reachability and SSH trust
	// from Alex-owned infrastructure to disposable MXM appliances.
	// ---------------------------------------------------------------------

	"tagOwners": {
		// Deployment-authority tag used by the narrowly scoped MXM
		// provisioning OAuth client. It is an authority tag, not normally
		// assigned to a running machine.
		"tag:mxm-bootstrap": [
			"autogroup:owner",
		],

		// MXM service identities assignable by the deployment authority.
		"tag:mxm-security": [
			"tag:mxm-bootstrap",
		],

		"tag:mxm-factory-agent": [
			"tag:mxm-bootstrap",
		],
	},

	"grants": [
		// Devices belonging to the Tailnet Owner may communicate freely
		// with that Owner's other user-owned devices.
		//
		// Today this provides Forge <-> Monolith connectivity.
		{
			"src": ["autogroup:owner"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},

		// Owner devices may reach the SSH service on MXM appliances.
		//
		// Actual SSH authorization is separately governed by the
		// Tailscale SSH policy below.
		{
			"src": ["autogroup:owner"],
			"dst": [
				"tag:mxm-security",
				"tag:mxm-factory-agent",
			],
			"ip": ["tcp:22"],
		},
		// Autonomous factory appliances may reach the workload-facing
		// OpenBao HTTPS endpoint on mxm-security.
		//
		// This grants network reachability only. OpenBao workload
		// authentication and authorization remain independently required.
		{
			"src": ["tag:mxm-factory-agent"],
			"dst": ["tag:mxm-security"],
			"ip":  ["tcp:443"],
		},
	],

	// Tailscale SSH is the administrative trust layer for reconstructible
	// MXM service appliances.
	//
	// The Tailnet Owner may log in only as the dedicated `mxm` operator
	// account. Root and arbitrary non-root login are not granted.
	"ssh": [
		{
			"action": "accept",
			"src": ["autogroup:owner"],
			"dst": [
				"tag:mxm-security",
				"tag:mxm-factory-agent",
			],
			"users": ["mxm"],
		},
	],

	// Security invariants checked whenever the network policy changes.
	"tests": [
		// Owner devices retain access to the Owner's own devices.
		{
			"src":   "moneyexmachina@github",
			"proto": "tcp",
			"accept": [
				"moneyexmachina@github:22",
			],
		},

		// The Tailnet Owner may reach SSH on MXM appliances,
		// but does not receive arbitrary service access.
		{
			"src":   "moneyexmachina@github",
			"proto": "tcp",
			"accept": [
				"tag:mxm-security:22",
				"tag:mxm-factory-agent:22",
			],
			"deny": [
				"tag:mxm-security:8200",
				"tag:mxm-factory-agent:8200",
			],
		},

		// The autonomous factory-agent identity has no lateral access
		// to the MXM security service or Alex-owned infrastructure.
		{
			"src":   "tag:mxm-factory-agent",
			"proto": "tcp",
			"accept": [
		        "tag:mxm-security:443",
		    	],
			"deny": [
		        "tag:mxm-security:22",
		        "tag:mxm-security:8200",
		        "moneyexmachina@github:22",
		        ],
		},	
		// The MXM security identity likewise receives no implicit
		// lateral access to the autonomous agent or Alex infrastructure.
		{
			"src":   "tag:mxm-security",
			"proto": "tcp",
			"deny": [
				"tag:mxm-factory-agent:22",
				"moneyexmachina@github:22",
			],
		},
	],

	// Tailscale SSH invariants are tested independently from network
	// reachability.
	"sshTests": [
		{
			"src": "moneyexmachina@github",
			"dst": [
				"tag:mxm-security",
				"tag:mxm-factory-agent",
			],
			"accept": ["mxm"],
			"deny": [
				"root",
				"openbao",
			],
		},
	],
}
